<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Sen JS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/vendor/lineicons/lineicons.css">
  <link rel="stylesheet" href="/assets/sen.css">
</head>
<body>
  <main class="mx-auto max-w-xl px-8 py-16 text-center">
    <h1 class="mb-4 text-3xl font-bold"><%= title %></h1>
    <p class="text-slate-500"><%= message %></p>
    <a href="/dashboard" class="mt-6 inline-flex items-center gap-2 text-indigo-600 no-underline hover:underline">
      <%- sen.component('icon', { name: 'dashboard', className: 'text-sm' }) %>
      Back to dashboard
    </a>
  </main>
</body>
</html>
