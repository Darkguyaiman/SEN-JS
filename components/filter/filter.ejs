<%
  const filterId = typeof id !== 'undefined' ? id : 'sen-filter';
  const filterOptions = typeof options !== 'undefined' ? options : [];
  const filterLabel = typeof label !== 'undefined' ? label : 'Filter';
  const filterName = typeof fieldName !== 'undefined' ? fieldName : (typeof name !== 'undefined' ? name : 'filter');
  const selectedValue = typeof value !== 'undefined' ? value : '';
%>

<div class="group/filter relative inline-block" data-sen-filter id="<%= filterId %>">
  <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-900 transition hover:border-slate-300 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 group-data-[open=true]/filter:border-indigo-500 group-data-[open=true]/filter:ring-2 group-data-[open=true]/filter:ring-indigo-500/20" data-filter-trigger aria-haspopup="listbox" aria-expanded="false">
    <%- sen.component('icon', { name: 'filter', className: 'text-sm text-slate-500' }) %>
    <span class="text-slate-500"><%= filterLabel %></span>
    <span class="font-semibold" data-filter-display><%= selectedValue || 'All' %></span>
    <%- sen.component('icon', { name: 'chevron', className: 'text-xs text-slate-400 transition group-data-[open=true]/filter:rotate-180' }) %>
  </button>

  <div class="absolute left-0 top-[calc(100%+0.375rem)] z-[150] hidden max-h-60 min-w-full overflow-y-auto rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg" data-filter-dropdown role="listbox">
    <button type="button" class="block w-full rounded-md px-3 py-2 text-left text-sm transition hover:bg-slate-50 <%= !selectedValue ? 'bg-indigo-50 font-semibold text-indigo-600' : 'text-slate-900' %>" data-filter-option data-value="" role="option">All</button>
    <% filterOptions.forEach(function(opt) {
         const val = typeof opt === 'string' ? opt : opt.value;
         const lbl = typeof opt === 'string' ? opt : opt.label;
    %>
    <button type="button"
            class="block w-full rounded-md px-3 py-2 text-left text-sm transition hover:bg-slate-50 <%= selectedValue === val ? 'bg-indigo-50 font-semibold text-indigo-600' : 'text-slate-900' %>"
            data-filter-option
            data-value="<%= val %>"
            role="option"><%= lbl %></button>
    <% }); %>
  </div>

  <input type="hidden" name="<%= filterName %>" value="<%= selectedValue %>" data-filter-input>
</div>
