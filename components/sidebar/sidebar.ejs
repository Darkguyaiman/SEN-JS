<%
  const navItems = typeof items !== 'undefined' ? items : [];
  const brandName = typeof brand !== 'undefined' ? brand : 'Sen JS';
  const currentUser = typeof user !== 'undefined' ? user : { name: 'User', role: 'Member' };

  const icons = {
    grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
    users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
    chart: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
    settings: '<circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>',
  };
%>

<aside
  id="sen-sidebar"
  class="group/sidebar fixed top-0 left-0 z-[100] flex h-screen w-64 -translate-x-full flex-col border-r border-slate-200 bg-white transition-all duration-150 md:translate-x-0 data-[collapsed=true]:md:w-[72px]"
  aria-label="Main navigation"
>
  <div class="flex min-h-16 items-center justify-between border-b border-slate-200 px-5 py-4">
    <a href="/dashboard" class="flex items-center gap-3 text-slate-900 no-underline hover:no-underline">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-lg font-bold text-white">S</span>
      <span class="truncate text-lg font-bold group-data-[collapsed=true]/sidebar:md:hidden"><%= brandName %></span>
    </a>
    <button type="button" class="rounded p-1 text-slate-500 hover:bg-slate-100 md:hidden" id="sen-sidebar-close" aria-label="Close menu">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto p-3">
    <ul class="flex flex-col gap-1">
      <% navItems.forEach(function(item) { %>
      <li>
        <a href="<%= item.href %>"
           class="flex items-center gap-3 rounded-lg px-3.5 py-2.5 text-sm font-medium no-underline transition <%= item.active ? 'bg-indigo-50 text-indigo-600' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>"
           <%= item.active ? 'aria-current="page"' : '' %>>
          <svg class="h-5 w-5 shrink-0 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><%- icons[item.icon] || icons.grid %></svg>
          <span class="truncate group-data-[collapsed=true]/sidebar:md:hidden"><%= item.label %></span>
        </a>
      </li>
      <% }); %>
    </ul>
  </nav>

  <div class="border-t border-slate-200 p-3">
    <%- sen.component('profile', { user: currentUser, compact: true }) %>
  </div>
</aside>

<button type="button" class="fixed top-4 left-4 z-[110] flex rounded-lg border border-slate-200 bg-white p-2 text-slate-900 shadow-sm md:hidden" id="sen-sidebar-toggle" aria-label="Toggle sidebar">
  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
</button>
