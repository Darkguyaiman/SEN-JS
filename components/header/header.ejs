<%
  const pageTitle = typeof title !== 'undefined' ? title : '';
  const crumbs = typeof breadcrumbs !== 'undefined' ? breadcrumbs : [];
  const headerUser = typeof user !== 'undefined' ? user : { name: 'User', role: 'Member' };
%>

<header class="sticky top-0 z-50 flex min-h-16 flex-wrap items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 md:px-6 md:pl-6" id="sen-header">
  <div class="min-w-0 pl-10 md:pl-0">
    <% if (crumbs.length) { %>
    <nav class="mb-0.5 flex items-center gap-1.5 text-xs text-slate-500" aria-label="Breadcrumb">
      <% crumbs.forEach(function(crumb, i) { %>
        <% if (i > 0) { %><span class="text-slate-300">/</span><% } %>
        <% if (crumb.href) { %>
        <a href="<%= crumb.href %>" class="text-slate-500 no-underline hover:text-indigo-600"><%= crumb.label %></a>
        <% } else { %>
        <span><%= crumb.label %></span>
        <% } %>
      <% }); %>
    </nav>
    <% } %>
    <h1 class="truncate text-xl font-bold tracking-tight"><%= pageTitle %></h1>
  </div>

  <div class="flex w-full items-center gap-3 md:w-auto md:flex-shrink-0">
    <%- sen.component('search-bar', { placeholder: 'Search...', id: 'header-search' }) %>
    <div class="hidden md:block">
      <%- sen.component('profile', { user: headerUser }) %>
    </div>
  </div>
</header>
