<%
  const profileUser = typeof user !== 'undefined' ? user : { name: 'User', role: 'Member', avatar: null };
  const isCompact = typeof compact !== 'undefined' && compact;
  const profileId = typeof id !== 'undefined' ? id : 'sen-profile';
  const initials = profileUser.name.split(' ').map(function(n) { return n[0]; }).join('').slice(0, 2).toUpperCase();
%>

<div class="group/profile relative" id="<%= profileId %>" data-sen-profile>
  <button type="button" class="flex w-full items-center gap-2.5 rounded-lg p-1.5 text-left transition hover:bg-slate-50" data-profile-trigger aria-haspopup="true" aria-expanded="false">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-indigo-50 text-sm font-bold text-indigo-600" aria-hidden="true">
      <% if (profileUser.avatar) { %>
      <img src="<%= profileUser.avatar %>" alt="" class="h-full w-full object-cover">
      <% } else { %>
      <%= initials %>
      <% } %>
    </span>
    <span class="min-w-0 flex-1 <%= isCompact ? 'group-data-[collapsed=true]/sidebar:md:hidden' : '' %>">
      <span class="block truncate text-sm font-semibold"><%= profileUser.name %></span>
      <span class="block truncate text-xs text-slate-500"><%= profileUser.role %></span>
    </span>
    <% if (!isCompact) { %>
    <svg class="h-4 w-4 shrink-0 text-slate-400 transition group-data-[open=true]/profile:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    <% } %>
  </button>

  <div class="absolute right-0 top-[calc(100%+0.375rem)] z-[200] hidden min-w-[180px] rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg <%= isCompact ? 'left-0 right-auto' : '' %>" data-profile-menu role="menu">
    <a href="#" class="block rounded-md px-3 py-2 text-sm text-slate-900 no-underline hover:bg-slate-50" role="menuitem">Profile</a>
    <a href="#" class="block rounded-md px-3 py-2 text-sm text-slate-900 no-underline hover:bg-slate-50" role="menuitem">Settings</a>
    <hr class="my-1.5 border-slate-200">
    <a href="#" class="block rounded-md px-3 py-2 text-sm text-red-500 no-underline hover:bg-red-50" role="menuitem">Sign out</a>
  </div>
</div>
